// prisma/schema.prisma
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ContactUs {
  id      Int  @id @default(autoincrement())
  name    String
  email   String
  phone   String?
  company String?
  message String
  preferredTime String?
}